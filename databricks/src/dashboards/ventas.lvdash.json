{
  "datasets": [
    {
      "name": "ds_ventas",
      "displayName": "Ventas",
      "asset_name": "${var.catalog}.${var.gold_schema}.ventas"
    },
    {
      "name": "ds_inventario",
      "displayName": "Inventario y cobertura",
      "queryLines": [
        "SELECT p.product AS producto, p.category AS categoria, i.warehouse AS almacen,\n",
        "       i.available AS disponible, i.on_hand AS existencia,\n",
        "       COALESCE(v.unidades, 0) AS vendido_90d,\n",
        "       CASE WHEN COALESCE(v.unidades,0) > 0\n",
        "            THEN ROUND(i.available / (v.unidades/90.0), 1) END AS dias_cobertura\n",
        "FROM fact_inventory i\n",
        "JOIN dim_product p ON p.product_id = i.product_id\n",
        "LEFT JOIN (SELECT product_id, SUM(quantity) AS unidades FROM fact_sales\n",
        "           WHERE order_status = 'sale' AND sale_date >= date_sub(current_date(), 90)\n",
        "           GROUP BY product_id) v ON v.product_id = i.product_id\n",
        "ORDER BY dias_cobertura ASC NULLS LAST"
      ]
    }
  ],
