# Secretos: odoo/.env lleva las credenciales reales del sandbox.
# El que se versiona es odoo/.env.example, con valores de juguete.
.env
odoo/.env
!odoo/.env.example

# Addons montados en el contenedor: la carpeta se versiona, su contenido no.
odoo/addons/*
!odoo/addons/.gitkeep

# Volúmenes o dumps que alguien deje caer al lado del compose
*.dump
*.sql.gz
*.tar.gz
odoo/pgdata/
odoo/odoo-data/

# Python (los scripts son stdlib pura, pero odoo shell deja basura)
__pycache__/
*.py[cod]
.venv/
venv/

# Estado local del bundle (lo genera el CLI)
databricks/.databricks/
.databricks/

# Editores y SO
.vscode/
.idea/
*.swp
.DS_Store
