# Copiar a .env y ajustar. .env NO se versiona.
#   cp odoo/.env.example odoo/.env
#
# Vive junto al docker-compose.yml porque Compose busca el .env en el
# directorio del archivo de compose, no en la raíz del repo. Así funciona
# tanto `make up` desde la raíz como `docker compose up` desde odoo/.
#
# Valores SIN comillas: el Makefile lee este archivo con `include` y Make,
# a diferencia de Compose, no las quita.
#
# Todos los valores tienen respaldo en docker-compose.yml, así que el sandbox
# levanta aunque no exista .env. En la EC2 sí conviene tener uno con
# credenciales propias.

# --- Postgres de Odoo -------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_dev
POSTGRES_DB=postgres

# Base de Odoo sobre la que corre la demo. Tiene que coincidir con db_name
# y dbfilter en odoo/config/odoo.conf.
ODOO_DB=demo

# --- Puertos publicados en el host ------------------------------------------
# 5432 se restringe por security group al rango de Databricks.
# 8069 solo a tu IP.
POSTGRES_PORT=5432
ODOO_PORT=8069

# --- Usuario de replicación para Lakeflow Connect ---------------------------
# Lo consume ingestion/cdc/lakeflow_setup.sql vía `make cdc-setup`.
# El pipeline de Databricks NUNCA usa credenciales de admin: en la conexión de
# Unity Catalog solo se guarda este usuario.
REPL_USER=databricks_replication
REPL_PASSWORD=cambiar_este_password

# Nombres de los objetos de replicación lógica.
REPL_PUBLICATION=databricks_pub
REPL_SLOT=databricks_slot
